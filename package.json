{
  "name": "saas-starter-open",
  "private": true,
  "version": "1.0.3",
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "lhci:desktop": "lhci autorun --config=lighthouserc.cjs --collect.settings.preset=desktop",
    "lhci:mobile": "lhci autorun --config=lighthouserc.cjs --collect.settings.preset=mobile",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts",
    "test:e2e:golden": "playwright test e2e/golden-path.spec.ts"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  }
}
