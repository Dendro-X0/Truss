{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "plugins": [{ "name": "next" }],
    "types": ["node", "react", "react-dom"],
    "paths": {
      "@saas-starter-open/db": ["../../packages/db/src/index.ts"],
      "@saas-starter-open/db/*": ["../../packages/db/src/*"],
      "@saas-starter-open/auth": ["../../packages/auth/src/index.ts"],
      "@saas-starter-open/auth/*": ["../../packages/auth/src/*"],
      "@saas-starter-open/email/*": ["../../packages/email/src/*"],
      "@saas-starter-open/rbac/*": ["../../packages/rbac/src/*"],
      "@/modules/*": ["./modules/*"],
      "@/components/shadcn-studio/*": ["./modules/ui/blocks/*"],
      "@/components/ui/*": ["../../packages/db/src/components/ui/*"],
      "@/components/*": ["../../packages/db/src/components/*"],
      "@/lib/*": ["../../packages/db/src/lib/*"],
      "@/saas-lib/*": ["./lib/*"],
      "@/hooks/*": ["../../packages/db/src/hooks/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": ["node_modules", "e2e/**"]
}
